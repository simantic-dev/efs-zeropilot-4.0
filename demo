#!/bin/sh
# Boots the ZeroPilot 4.0 plane firmware on the simulated STM32H753 with the peers in sim/, then prints the
# MAVLink the firmware sent on USART1, decoded by sim/view.py. Usage: ./demo [virtual-seconds]
# Needs `sim` on PATH (or SIM=/path/to/sim) and the firmware built with sim/build.sh. sim/run.sh is the PASS/FAIL check.
set -eu
SIM="${SIM:-sim}"
cd "$(dirname "$0")/sim"
command -v "$SIM" >/dev/null || { echo "sim not found. Install it: curl -fsSL https://simantic.com/install | sh" >&2; exit 1; }
[ -f ../stm32h753iitx/build-h753/stm32h753iitx.elf ] || { echo "firmware missing: run sim/build.sh first" >&2; exit 1; }
mkdir -p out
./make_card.sh out/card.img
"$SIM" run --scenario scenario.yaml --timeout "${1:-20}" --output out/out.txt --frames out/frames.txt 2>&1 \
  | grep --line-buffered -E 'allocated node id|bad crc|Elapsed'
python3 view.py out/out.txt > out/view.txt
awk '/^STATUSTEXT$/{exit} 1' out/view.txt
echo "done: ${1:-20} virtual s, $(tail -1 out/view.txt | cut -d' ' -f1) CRC-valid MAVLink frames decoded from USART1"
